# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Server & URLs
PORT=4000
API_URL=https://your-backend-service.onrender.com
FRONTEND_URL=https://vertex-mu-eight.vercel.app,http://localhost:5173

# Email Verification (set to true on Render free tier to prevent SMTP timeouts)
AUTO_VERIFY_EMAIL=true
DISABLE_EMAIL_VERIFY=false

# Resend Email Configuration (Recommended for Render, Vercel, and Cloud)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdef
# Test from address: Vertex LMS <onboarding@resend.dev> | Custom domain: Vertex LMS <support@yourdomain.com>
EMAIL_FROM="Vertex LMS <onboarding@resend.dev>"

# Optional / Fallback Google OAuth2 Mail Credentials
# EMAIL_USER=your-email@gmail.com
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Optional: App Password or Custom SMTP
# EMAIL_PASS=your-google-app-password
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-pass

# ImageKit (Media storage)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Razorpay (Payments)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_SECRET_ID=xxxx

# Mistral AI (AI Tutor & Transcriptions)
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest

# Stream IO (Live Classes)
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Redis Cache (Optional: Enables distributed L2 SSR & API caching)
# Cloud / Upstash / Redis Cloud:
# REDIS_URL=rediss://default:your_password@your-redis-host.upstash.io:6379
# Local / Self-Hosted:
# REDIS_URL=redis://127.0.0.1:6379

